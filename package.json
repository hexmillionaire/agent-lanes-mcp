{
  "name": "@hexmillionaire/agent-lanes-mcp",
  "version": "0.4.2",
  "description": "Read-only MCP server that lets Claude Code, Codex, Cursor and other MCP clients audit coding-task file scopes and fetch handoffs from local Git repos.",
  "mcpName": "io.github.hexmillionaire/agent-lanes-mcp",
  "type": "module",
  "bin": {
    "agent-lanes-mcp": "bin/agent-lanes-mcp.mjs"
  },
  "files": [
    "bin",
    "src",
    "vendor",
    "README.md",
    "LICENSE",
    "docs",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "start": "node bin/agent-lanes-mcp.mjs",
    "test": "node --test",
    "test:inspector": "node scripts/inspector-smoke.mjs",
    "test:package": "node scripts/package-smoke.mjs",
    "test:vendor": "node scripts/verify-vendor.mjs"
  },
  "engines": {
    "node": ">=24.8.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hexmillionaire/agent-lanes-mcp.git"
  },
  "homepage": "https://github.com/hexmillionaire/agent-lanes-mcp#readme",
  "bugs": {
    "url": "https://github.com/hexmillionaire/agent-lanes-mcp/issues"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude-code",
    "claude-desktop",
    "codex",
    "cursor",
    "ai-agents",
    "coding-agent",
    "git",
    "scope",
    "guardrails",
    "handoff",
    "task-scope"
  ],
  "devDependencies": {
    "@modelcontextprotocol/inspector": "2.13.0",
    "ajv": "8.20.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
